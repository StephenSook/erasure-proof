# Copy to .env and fill in. NEVER commit a filled .env (see .gitignore).
# Every value here is a placeholder.

# --- CockroachDB (system of record) ---
# Cloud cluster DSN, sslmode=verify-full with the cluster CA bundled in the image.
CRDB_DSN=postgresql://USER:PASSWORD@HOST:26257/erasure?sslmode=verify-full
# Optional separate cluster for the C-SPANN vector path (Branch B, see plan).
CRDB_DSN_VECTOR=
# Role-scoped DSNs used by the two API pools (least privilege).
CRDB_DSN_AGENT_WORKER=postgresql://agent_worker:PASSWORD@HOST:26257/erasure?sslmode=verify-full
CRDB_DSN_OPERATOR=postgresql://operator:PASSWORD@HOST:26257/erasure?sslmode=verify-full
# SELECT-only role for the read-only forensics MCP server.
CRDB_DSN_FORENSICS_READER=postgresql://forensics_reader:PASSWORD@HOST:26257/erasure?sslmode=verify-full

# --- Local 3-node cluster (docker-compose.crdb.yml, --insecure) ---
CRDB_DSN_LOCAL=postgresql://root@localhost:26257/erasure?sslmode=disable

# --- AWS ---
AWS_REGION=us-east-1
# KMS: one wrapping CMK (GenerateDataKey) + one external-material CMK (DeleteImportedKeyMaterial).
KMS_WRAPPING_KEY_ARN=arn:aws:kms:us-east-1:ACCOUNT:key/REPLACE
KMS_EXTERNAL_KEY_ARN=arn:aws:kms:us-east-1:ACCOUNT:key/REPLACE
# S3 proof anchor (Object Lock). Use the -dev bucket (GOVERNANCE, 1-day) for all development.
S3_PROOF_BUCKET=erasure-proof-anchor-dev
S3_PROOF_OBJECT_LOCK_MODE=GOVERNANCE
S3_PROOF_RETAIN_DAYS=1
# Bedrock inference. Use the CROSS-REGION inference-profile id (us.anthropic.*); the bare
# anthropic.* id fails with "on-demand throughput isn't supported".
AGENTS_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_TITAN_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# --- ECDSA proof signing (P-256). Prefer KMS asymmetric Sign in production. ---
# For local dev only; production injects from SSM SecureString.
ECDSA_SIGNING_KEY_PATH=./certs/ecdsa_p256_private.pem

# --- Service wiring ---
API_PORT=8080
CRYPTOD_URL=http://localhost:8081
MCP_PORT=8082
# Read-only demo bearer key for the public forensics MCP endpoint (rate-limited, audit-logged).
MCP_DEMO_KEY=replace-with-random-demo-key

# --- Embedding model (invertibility demo) ---
GTR_MODEL=sentence-transformers/gtr-t5-base
VEC2TEXT_INVERSION_CKPT=jxm/gtr__nq__32
VEC2TEXT_CORRECTOR_CKPT=jxm/gtr__nq__32__correct

# --- CockroachDB Cloud service account (Managed MCP + RBAC demo) ---
# Least-privilege service account: CLUSTER_DEVELOPER + CLUSTER_OPERATOR_WRITER scoped to the
# one cluster, nothing org-wide. Used by infra/ccloud/mcp-verify.sh and rbac-demo.sh.
CCLOUD_SA_ID=replace-with-service-account-id
CCLOUD_SA_API_KEY=replace-with-service-account-api-key
CRDB_CLUSTER_ID=replace-with-cluster-uuid
